# Expo Environment Variables for ISS396 Mobile App

# API Base URL (change to your backend server)
# For local development on iOS simulator:
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# For local development on Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# For device testing (use your machine's IP):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api

# For production:
# EXPO_PUBLIC_API_URL=https://your-backend-domain.com/api
